# Copy this file to .env and replace placeholder values for the environment.

# PostgreSQL (local Docker Compose)
POSTGRES_DB=miniticket
POSTGRES_USER=miniticket
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend environment
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://miniticket:replace-with-a-local-password@db:5432/miniticket

# Frontend API URL
VITE_API_URL=http://localhost:3000
