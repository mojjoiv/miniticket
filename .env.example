# Copy this file to .env and replace placeholder values for your environment.
# These are example settings only, not production credentials.

# PostgreSQL (local Docker Compose)
POSTGRES_DB=miniticket
POSTGRES_USER=miniticket
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend API
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://miniticket:replace-with-a-local-password@db:5432/miniticket

# Frontend API URL (used by Vite at build/dev time)
VITE_API_URL=http://localhost:3000
